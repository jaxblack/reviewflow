[Unit]
Description=ReviewFlow MVP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/reviewflow/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=COOKIE_SECURE=true
Environment=COOKIE_PATH=/reviewflow
Environment=REVIEWFLOW_WRITE_RATE_LIMIT=30
Environment=REVIEWFLOW_MAX_USERS=100
Environment=REVIEWFLOW_MAX_CONTENTS=500
Environment=REVIEWFLOW_MAX_ROUNDS_PER_CONTENT=20
Environment=REVIEWFLOW_MAX_IDEMPOTENCY_RECORDS=2000
Environment=REVIEWFLOW_IDEMPOTENCY_TTL_HOURS=24
EnvironmentFile=%h/apps/reviewflow/shared/reviewflow.env
ExecStart=/usr/bin/node dist-server/server/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=default.target