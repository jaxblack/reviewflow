{
  "name": "reviewflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "npm run docs:build && concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "NODE_ENV=development PORT=3001 tsx watch server/index.ts",
    "dev:web": "vite",
    "docs:build": "node scripts/generate-docs.mjs",
    "docs:check": "node scripts/generate-docs.mjs --check",
    "build": "npm run docs:build && tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "db:migrate": "node dist-server/server/postgres/migrate.js",
    "seed:demo": "node dist-server/server/seed-demo.js",
    "test": "node scripts/require-test-database.mjs && vitest run",
    "test:postgres": "node scripts/require-test-database.mjs && vitest run server/app.test.ts server/seed-demo.test.ts server/postgres-schema.test.ts server/concurrency.test.ts",
    "test:watch": "vitest",
    "lint": "oxlint src server",
    "check": "npm run lint && npm test && npm run docs:check && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.12.5",
    "lucide-react": "^1.47.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
